<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ServeLinkApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/surface</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryContainer">@color/accent</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/status_error</item>
        <item name="colorOutline">@color/divider</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:fontFamily">@font/gelanos</item>
        <item name="fontFamily">@font/gelanos</item>

        <item name="materialButtonStyle">@style/Widget.ServeLink.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.ServeLink.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.ServeLink.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.ServeLink.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.ServeLink.Card</item>
        <item name="chipStyle">@style/Widget.ServeLink.Chip</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.ServeLinkApp.Splash" parent="Theme.ServeLinkApp">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Material Button -->
    <style name="Widget.ServeLink.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.ServeLink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.ServeLink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Text Input -->
    <style name="Widget.ServeLink.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Widget.ServeLink.TextInput.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeWidth">0dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.ServeLink.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="android:background">@color/white</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@color/ripple_dark</item>
    </style>

    <!-- Card -->
    <style name="Widget.ServeLink.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="Widget.ServeLink.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Chip -->
    <style name="Widget.ServeLink.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gelanos</item>
    </style>

    <style name="Widget.ServeLink.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="android:fontFamily">@font/gelanos</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.ServeLink.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.ServeLink.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.ServeLink.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.ServeLink.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.ServeLink.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Date Picker Dialog -->
    <style name="CustomDatePickerDialogTheme" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">#424242</item>
        <item name="android:colorAccent">@color/black</item>
    </style>

    <!-- Bottom Sheet -->
    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Tab Layout -->
    <style name="TabLayoutTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/gelanos</item>
    </style>

    <!-- Custom Chip Text -->
    <style name="CustomChipTextAppearance" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/gelanos</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"/>

    <!-- Messages Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <!-- Typing Indicator text overlay -->
    <TextView
        android:id="@+id/tvTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:text="User is typing..."
        android:textColor="@color/text_color"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- Message Input Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <!-- Attachment Button -->
        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/round100"
            android:src="@drawable/camera_minimalistic_svgrepo_com"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            app:tint="@color/black"
            android:contentDescription="Attach photo/file" />

        <!-- Input Field -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/round100"
            android:hint="Type a message..."
            android:textColor="@color/black"
            android:textColorHint="@color/text_color"
            android:layout_marginEnd="12dp"
            android:padding="15dp"
            android:textSize="15sp"
            android:elevation="0dp" />

        <!-- Send Button -->
        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/indicator_active"
            android:src="@drawable/send_1_svgrepo_com"
            android:padding="12dp"
            app:tint="@color/white"
            android:contentDescription="Send message"
            android:elevation="2dp" />

    </LinearLayout>
</LinearLayout>
